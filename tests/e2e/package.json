{
  "name": "@nexus/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end tests exercising the full stack (real Postgres, real agent HTTP/WS).",
  "scripts": {
    "test": "bun run test:attach",
    "test:attach": "bun test ./attach-websocket.test.ts",
    "test:e2e": "bun run test",
    "build:web": "NEXT_PUBLIC_NEXUS_AGENT_URL=http://${NEXUS_TS_HOST:-100.73.182.4}:7400 pnpm --filter @nexus/web build",
    "test:playwright": "playwright test --config=playwright/playwright.config.ts",
    "test:playwright:full": "pnpm run build:web && pnpm run test:playwright",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nexus/agent": "workspace:*",
    "@nexus/core": "workspace:*",
    "@nexus/db": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
