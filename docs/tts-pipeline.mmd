%%{init: {'theme': 'dark', 'themeVariables': {'primaryColor': '#1a1b26', 'primaryTextColor': '#c0caf5', 'primaryBorderColor': '#7aa2f7', 'lineColor': '#565f89', 'secondaryColor': '#24283b', 'tertiaryColor': '#1a1b26', 'edgeLabelBackground': '#1a1b26', 'clusterBkg': '#1a1b26', 'clusterBorder': '#565f89'}}}%%

flowchart TB
    subgraph emission["Emission"]
        direction TB
        hook_trigger["CC hook lifecycle<br/>(hook-trigger.ts)"]
        external["External client<br/>(e.g. CC-side nx_notify,<br/>separate repo)"]
    end

    subgraph routes["apps/agent/src/routes/notifications.ts"]
        direction TB
        send_route["POST /notifications/send"]
        dedup["isDuplicate()<br/>sha256(body|channel|project)<br/>DEDUP_TTL_MS = 5000ms"]
        send_route --> dedup
    end

    hook_trigger --> send_route
    external --> send_route

    subgraph manager["NotificationManager (manager.ts)"]
        direction TB
        insert["insertNotification()<br/>(buffer.ts — always runs first)"]
        legacy_check["Legacy fallback:<br/>meetingState.active<br/>buffer/drop check"]
        insert --> route_decision{"presence_aware_routing<br/>enabled AND vector has<br/>>=1 known field?"}
    end

    dedup -->|"not a duplicate"| insert

    subgraph presence["Presence-aware routing"]
        direction TB
        decide["decidePresenceRoute()<br/>(router.ts)"]
        rules["evaluateRules()<br/>(rules-engine.ts)<br/>Rule 1: active Mac, not in meeting -> banner+tts<br/>Rule 2: Mac present + in meeting -> HOLD<br/>Rule 3: bedtime + idle Mac -> silent phone banner<br/>Rule 4: Mac idle/locked + phone home -> room-tts<br/>terminal: fallback digest"]
        vector["PresenceVector<br/>(presence-context.ts)"]
        decide --> rules
        vector --> rules
    end

    route_decision -->|"yes"| decide
    route_decision -->|"no, or vector all-unknown<br/>(decidePresenceRoute returns null)"| legacy_check

    subgraph hold["Meeting-hold coalescing"]
        direction TB
        held_queue["HeldQueue<br/>(held-queue.ts)<br/>persists to presence_holds table<br/>(durable — survives agent restart)"]
        flush["manager.flushHeldBatch()<br/>ONE coalesced summary notification"]
        held_queue -.->|"later"| flush
    end

    rules -->|"Rule 2 match"| held_queue

    subgraph delivery["Delivery (router.ts)"]
        direction TB
        parallel["routeNotificationParallel()<br/>fans out to channel handlers"]
        tts["tts channel<br/>(ElevenLabs synthesis via<br/>notifications/audio-store.ts,<br/>or Mac-side NexusShared client)"]
        desktop["desktop channel"]
        telegram["telegram channel"]
        parallel --> tts
        parallel --> desktop
        parallel --> telegram
    end

    rules -->|"Rule 1 / Rule 4 / non-hold match"| parallel
    legacy_check --> parallel
    flush --> parallel

    subgraph lifecycle["Lifecycle"]
        direction TB
        mark_delivered["markNotificationDelivered()<br/>(buffer.ts)"]
        emit["lifecycleBus.emit(\"NotificationFired\", ...)<br/>-> SSE subscribers<br/>(Swift dashboards, statusline)"]
        mark_delivered --> emit
    end

    tts -->|"channel success"| mark_delivered
    desktop -->|"channel success"| mark_delivered
    telegram -->|"channel success"| mark_delivered

    style emission fill:#1a1b26,stroke:#7aa2f7,stroke-width:2px
    style routes fill:#1a1b26,stroke:#e0af68,stroke-width:2px
    style manager fill:#1a1b26,stroke:#9ece6a,stroke-width:2px
    style presence fill:#1a1b26,stroke:#bb9af7,stroke-width:2px
    style hold fill:#1a1b26,stroke:#7dcfff,stroke-width:2px
    style delivery fill:#1a1b26,stroke:#f7768e,stroke-width:2px
    style lifecycle fill:#1a1b26,stroke:#565f89,stroke-width:2px
