<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
        <string>fetch</string>
        <string>processing</string>
    </array>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>dev.leonardoacosta.nexus.ios.health.refresh</string>
        <string>dev.leonardoacosta.nexus.ios.health.processing</string>
    </array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>dev.leonardoacosta.nexus.ios</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>nexus</string>
            </array>
        </dict>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NEXUS_ENDPOINT</key>
    <string>http://homelab:7400</string>
    <key>NSHealthShareUsageDescription</key>
    <string>Nexus reads your Health data — including metrics recorded by third-party devices like WHOOP and Oura, and your medications and logged doses — and mirrors it to your own private homelab health store over your tailnet. Data never leaves hardware you own.</string>
    <key>NSFocusStatusUsageDescription</key>
    <string>Nexus reads whether a Focus (including Sleep) is active so it can route or quiet notifications during bedtime and Focus on your own homelab — the status never leaves hardware you own.</string>
    <key>HEALTH_INGEST_ENDPOINT</key>
    <string>http://homelab:8798/ingest</string>
    <key>HEALTH_INGEST_ENDPOINT_AP</key>
    <string>https://apothecary.leonardoacosta.dev/api/health/ingest</string>
    <key>HEALTH_INGEST_TOKEN_AP</key>
    <string>$(HEALTH_INGEST_TOKEN_AP)</string>
</dict>
</plist>
