// nexus-ios secrets — TEMPLATE.
//
// Copy this file to `Secrets.xcconfig` (same directory) and fill in the real
// values. `Secrets.xcconfig` is GITIGNORED so the live bearer token never enters
// version control. XcodeGen wires it via the nexus-ios target's `configFiles:`
// (apps/swift/project.yml); the Info.plist keys below resolve the `$(VAR)` build
// settings at build time, so the token lives ONLY in the local, gitignored file.
//
// If `Secrets.xcconfig` is absent, the build degrades gracefully:
//   - HEALTH_INGEST_ENDPOINT_AP / HEALTH_INGEST_TOKEN_AP resolve to empty, so
//     HealthKitPushManager drops the Apothecary target and pushes mx-only.
//
// After creating/editing Secrets.xcconfig, regenerate the project:
//   cd apps/swift && xcodegen generate

// Apothecary (ap) health-metric ingest bearer token. Must match the ap
// deployment's HEALTH_INGEST_TOKEN env var EXACTLY (case-sensitive Bearer compare).
HEALTH_INGEST_TOKEN_AP = REPLACE_WITH_AP_HEALTH_INGEST_TOKEN

// mx homelab sidecar / ingest bearer tokens (mx plan 006 fail-closed listeners).
// Each MUST match the corresponding mx daemon env var in ~/.mx/env EXACTLY
// (case-sensitive Bearer compare): MEDS_TOKEN=MX_MEDS_TOKEN (mx-meds :8802),
// PLAID_CONTROL_TOKEN=MX_PLAID_CONTROL_TOKEN (mx-plaid :8801),
// HEALTH_INGEST_TOKEN=MX_HEALTH_INGEST_TOKEN (mx-health ingest :8798).
// SettingsStore resolves these as the build-time default; a per-device override
// entered in the Mac Tokens settings pane takes precedence.
MEDS_TOKEN = REPLACE_WITH_MEDS_TOKEN
PLAID_CONTROL_TOKEN = REPLACE_WITH_PLAID_CONTROL_TOKEN
HEALTH_INGEST_TOKEN = REPLACE_WITH_HEALTH_INGEST_TOKEN

// mx-gateway WRITE-surface bearer token (mx triage-ledger design §4, fail-closed).
// MUST match the gateway's MX_GATEWAY_TOKEN env var in ~/.mx/env EXACTLY
// (case-sensitive Bearer compare). Gates every gateway POST — the triage-ledger
// done/snooze routes AND the existing decide /requests/{id}/decision route.
// If empty the app still builds/runs and reads work, but gateway POSTs 401 until
// this is set. A per-device override entered in the Mac Tokens pane takes precedence.
GATEWAY_TOKEN = REPLACE_WITH_GATEWAY_TOKEN
