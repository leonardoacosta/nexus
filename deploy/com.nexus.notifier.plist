<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nexus.notifier</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>/Users/leonardoacosta/bin/nexus-notifier.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NEXUS_URL</key>
    <string>http://homelab:7400</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/leonardoacosta/Library/Logs/nexus-notifier.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/leonardoacosta/Library/Logs/nexus-notifier.err.log</string>

  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
