<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nexus.notifier</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>/Users/leonardoacosta/bin/nexus-notifier.sh listen</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NEXUS_URL</key>
    <string>http://homelab:7400</string>
    <!-- Pre-bootstrap defaults — the listener calls GET /notifications/settings
         on startup and replaces these in-process. Defaults match the spec:
         tts on, banner on, ducking off (none -> normalized to "full"). Flip
         a value here to suppress a fresh install before the GET completes. -->
    <key>TTS_ENABLED</key>
    <string>1</string>
    <key>BANNER_ENABLED</key>
    <string>1</string>
    <key>DUCKING_MODE</key>
    <string>none</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/leonardoacosta/Library/Logs/nexus-notifier.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/leonardoacosta/Library/Logs/nexus-notifier.err.log</string>

  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
