<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nexus.notifier</string>

  <!--
    SSE consumer is now Bun-native (deploy/nexus-listener.ts) — replaces
    the bash `nexus-notifier.sh listen` mode which suffered from bash 3.2
    process-substitution lifecycle bugs and pipe-buffering issues.
    The bash `drain` mode (com.nexus.tts-player) is unchanged.
    Spec: openspec/changes/restore-bun-listener/ (2026-05-16 reversal of
    consolidate-mac-tts-listener).
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/bun</string>
    <string>run</string>
    <string>/Users/leonardoacosta/bin/nexus-listener.ts</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NEXUS_URL</key>
    <string>http://localhost:7400</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/leonardoacosta/Library/Logs/nexus-notifier.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/leonardoacosta/Library/Logs/nexus-notifier.err.log</string>

  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
