# Nexus agent secrets — example template
#
# Copy to ~/.config/nexus/secrets.env on each machine running nexus-agent.
# This file is sourced by launchctl setenv (macOS) and the systemd
# EnvironmentFile= directive (Linux) at agent startup.
#
# NEVER commit the populated file. ~/.config/nexus/secrets.env is intentionally
# outside the repo. This .example is the contract reference.

# ── Postgres (homelab Cortex DB) ─────────────────────────────────────
POSTGRES_URL=postgres://cortex:cortexdev@homelab:5436/nexus

# ── Attach + encryption secrets (generated once via openssl rand) ────
NEXUS_ATTACH_SECRET=<hex64>
NEXUS_ENCRYPTION_KEY=<hex64>

# ── ElevenLabs TTS ───────────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_<redacted>

# ── Apple Push Notification service ──────────────────────────────────
# Reuses APNs Auth Key (Apple's 2-key-per-team limit hit; do NOT create a
# new key — Z3BX2Y72Q7 is canonical). Wired into apps/agent push-delivery
# pipeline (see bd:nx-5eqal). Provisioning workflow in apps/swift/fastlane/.
APNS_KEY_ID=Z3BX2Y72Q7
APNS_TEAM_ID=DX3Y367L2A
APNS_KEY_PATH=/Users/leonardoacosta/.appstoreconnect/private_keys/AuthKey_Z3BX2Y72Q7.p8
APNS_BUNDLE_IOS=dev.leonardoacosta.nexus.ios
APNS_BUNDLE_WATCH=dev.leonardoacosta.nexus.watch

# ── OpenTelemetry tracing (optional) ─────────────────────────────────
# When OTEL_EXPORTER_OTLP_ENDPOINT is set, the agent exports spans via
# OTLP/HTTP (BatchSpanProcessor) and pino forwards logs with trace/span IDs.
# Leave unset for local dev — spans fall back to the console exporter.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=nexus
