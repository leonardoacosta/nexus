#!/usr/bin/env bash
set -euo pipefail

# Nexus Agent — pre-push deploy hook
# Builds release on pushes to main, installs, and enables service.
# Aborts push on build failure. Skip with: SKIP_DEPLOY=1 git push
#
# v4 stack: Bun (nexus-agent)

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
RESET='\033[0m'

info()  { printf "${GREEN}nexus-agent: %s${RESET}\n" "$1"; }
skip()  { printf "${YELLOW}nexus-agent: %s${RESET}\n" "$1"; }
warn()  { printf "${YELLOW}nexus-agent: %s${RESET}\n" "$1" >&2; }
fail()  { printf "${RED}nexus-agent: %s${RESET}\n" "$1" >&2; exit 1; }

# Bootstrap with retry — handles macOS launchctl `Load failed: 5: I/O error`
# AND the silent-success failure mode where bootstrap exits 0 but the service
# never actually starts. The PID check is the only reliable signal; trust no
# exit code, trust no log line. Mirror of the helper in post-merge/02-deploy.
bootstrap_with_retry() {
    local label="$1" plist="$2"
    local attempt pid_line pid
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    for attempt in 1 2 3; do
        sleep "$attempt"
        launchctl bootstrap "gui/$(id -u)" "$plist" >/dev/null 2>&1 || true
        launchctl kickstart -k "gui/$(id -u)/$label" >/dev/null 2>&1 || true
        pid_line=$(launchctl list "$label" 2>/dev/null | grep '"PID"' | head -1)
        pid=$(printf '%s' "$pid_line" | sed -nE 's/.*"PID" = ([0-9]+).*/\1/p')
        if [ -n "$pid" ] && [ "$pid" -gt 0 ] 2>/dev/null; then
            info "$label running (pid=$pid, attempt=$attempt)"
            return 0
        fi
        launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    done
    warn "$label failed to start after 3 attempts — run: launchctl bootstrap gui/\$(id -u) $plist"
    return 1
}

# ── Skip guard ────────────────────────────────────────────────────

if [[ "${SKIP_DEPLOY:-0}" == "1" ]]; then
    skip "SKIP_DEPLOY set, bypassing build"
    exit 0
fi

# ── Branch filter ─────────────────────────────────────────────────

PUSHING_MAIN=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        PUSHING_MAIN=1
        break
    fi
done

if [[ "$PUSHING_MAIN" -eq 0 ]]; then
    skip "not pushing to main, skipping build"
    exit 0
fi

# ── Paths ─────────────────────────────────────────────────────────

BIN_DIR="$HOME/.local/bin"
CONFIG_DIR="$HOME/.config/nexus"
REPO_DIR="$(git rev-parse --show-toplevel)"
DEPLOY_DIR="$REPO_DIR/deploy"

mkdir -p "$BIN_DIR" "$CONFIG_DIR"

START=$(date +%s)

# ── Build Bun nexus-agent ─────────────────────────────────────────

info "building Bun nexus-agent..."
(cd "$REPO_DIR/apps/agent" && bun run build) || fail "apps/agent build failed"

ELAPSED=$(( $(date +%s) - START ))
info "built in ${ELAPSED}s"

# ── Install binaries ──────────────────────────────────────────────

# Stop agent before replacing binary (avoid "Text file busy")
systemctl --user stop nexus-agent 2>/dev/null || true

install -m 755 "$REPO_DIR/apps/agent/nexus-agent"              "$BIN_DIR/nexus-agent"
info "binaries installed to $BIN_DIR/"

# ── Install and enable service ────────────────────────────────────

OS="$(uname -s)"
case "$OS" in
    Linux)
        SYSTEMD_DIR="$HOME/.config/systemd/user"
        mkdir -p "$SYSTEMD_DIR"
        install -m 644 "$DEPLOY_DIR/nexus-agent.service" "$SYSTEMD_DIR/nexus-agent.service"
        systemctl --user daemon-reload
        systemctl --user enable nexus-agent
        info "running database migrations..."
        (cd "$REPO_DIR" && pnpm --filter @nexus/db db:migrate) || fail "db:migrate failed"
        systemctl --user start nexus-agent
        info "systemd service enabled and started"
        ;;
    Darwin)
        LAUNCH_DIR="$HOME/Library/LaunchAgents"
        PLIST="$LAUNCH_DIR/com.nexus.agent.plist"
        mkdir -p "$LAUNCH_DIR"
        sed "s|\${USER}|$USER|g" "$DEPLOY_DIR/com.nexus.agent.plist" > "$PLIST"
        # Use bootstrap_with_retry instead of legacy `launchctl load`.
        # Load returns 0 even when the service fails to actually start
        # (the silent-success bug); bootstrap_with_retry verifies PID.
        bootstrap_with_retry "com.nexus.agent" "$PLIST"
        ;;
esac

info "deploy complete"
