#!/usr/bin/env bash

# Nexus Rust Agent — post-merge rebuild hook
# Rebuilds the Rust nexus-agent binary and restarts the systemd service
# when crates/ or Cargo files change. Linux only.

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
RESET='\033[0m'

info() { printf "${GREEN}rust-agent: %s${RESET}\n" "$1"; }
skip() { printf "${YELLOW}rust-agent: %s${RESET}\n" "$1"; }
warn() { printf "${RED}rust-agent: %s${RESET}\n" "$1" >&2; }

# ── Skip on macOS ────────────────────────────────────────────────

if [[ "$(uname -s)" == "Darwin" ]]; then
    skip "macOS detected, skipping (launchd handled separately)"
    exit 0
fi

# ── Check for relevant changes ───────────────────────────────────

if ! git diff-tree -r --name-only ORIG_HEAD HEAD 2>/dev/null | grep -qE '^(crates/|Cargo\.toml|Cargo\.lock)'; then
    skip "no Rust source changes, skipping"
    exit 0
fi

# ── Rebuild ──────────────────────────────────────────────────────

REPO_DIR="$(git rev-parse --show-toplevel)"

info "rebuilding nexus-agent..."
START=$(date +%s)

if ! (cd "$REPO_DIR" && cargo build --release -p nexus-agent); then
    warn "cargo build failed, skipping install and restart"
    exit 0
fi

ELAPSED=$(( $(date +%s) - START ))
info "rebuilt in ${ELAPSED}s"

# ── Install binary ──────────────────────────────────────────────

BIN_DIR="$HOME/.local/bin"
mkdir -p "$BIN_DIR"

install -m 755 "$REPO_DIR/target/release/nexus-agent" "$BIN_DIR/nexus-agent"
info "binary installed to $BIN_DIR/nexus-agent"

# ── Restart service ──────────────────────────────────────────────

if ! systemctl --user restart nexus-agent; then
    warn "systemctl restart failed, service may need manual attention"
    exit 0
fi

info "nexus-agent service restarted"
