#!/usr/bin/env bash
set -euo pipefail

# Nexus Agent — post-merge deploy hook
# Rebuilds and fully deploys nexus-agent when Bun source changes.
# Handles first-time setup (config, service install, enable) and updates.

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
RESET='\033[0m'

info()  { printf "${GREEN}nexus-agent: %s${RESET}\n" "$1"; }
skip()  { printf "${YELLOW}nexus-agent: %s${RESET}\n" "$1"; }
warn()  { printf "${YELLOW}nexus-agent: %s${RESET}\n" "$1" >&2; }
fail()  { printf "${RED}nexus-agent: %s${RESET}\n" "$1" >&2; exit 1; }

# ── Check for code changes (skip with --force) ───────────────────

if [[ "${1:-}" != "--force" ]]; then
    if ! git diff-tree -r --name-only ORIG_HEAD HEAD 2>/dev/null | grep -qE '^(apps/agent/|apps/nexus-statusline/|deploy/)'; then
        skip "no code changes, skipping rebuild (use --force to override)"
        exit 0
    fi
fi

# ── Rebuild ───────────────────────────────────────────────────────

BIN_DIR="$HOME/.local/bin"
CONFIG_DIR="$HOME/.config/nexus"
REPO_DIR="$(git rev-parse --show-toplevel)"
DEPLOY_DIR="$REPO_DIR/deploy"

# get_remote_agents (agents.toml parser) and run_deploy_with_retry (SSH
# retry-with-backoff) — shared with the deploy-staleness cron job so there is
# ONE implementation of each instead of copies drifting apart (nx-eff6w,
# nx-695re).
# shellcheck source=../../lib/remote-agents.sh
source "$DEPLOY_DIR/lib/remote-agents.sh"
# shellcheck source=../../lib/deploy-retry.sh
source "$DEPLOY_DIR/lib/deploy-retry.sh"

mkdir -p "$BIN_DIR" "$CONFIG_DIR"

# ── Sync dependencies ───────────────────────────────────────────
#
# Always run, unconditionally. A diff-based skip (only install when
# THIS push's commit range touched package.json/lockfile) misses the
# case where an EARLIER push added a dependency and that machine's
# install was skipped or failed at the time — this push's diff shows
# no lockfile change, so a diff-only heuristic would skip forever
# (nx-qqrte, reproduced 2026-07-05: apps/agent/src/otel.ts deps
# unresolvable on a Mac after exactly this drift). The outer
# apps/agent/ or deploy/ gate above already restricts this hook to
# relevant pushes, and `bun install --frozen-lockfile` is a fast
# no-op when node_modules already matches the lockfile, so dropping
# the extra diff check trades a small, bounded cost for eliminating
# the whole class of "install silently skipped forever" drift.
info "syncing dependencies (bun install --frozen-lockfile)"
if ! (cd "$REPO_DIR" && bun install --frozen-lockfile); then
    # Lockfile drift (nx-zpbqi) used to trigger a non-frozen recovery install
    # here (removed by converge-package-manager, nx-4vuh1). Since CI now
    # carries a second-lockfile guard and pnpm is gone, a frozen-install
    # failure means the committed bun.lock genuinely does not match resolved
    # dependencies — that should have been caught before merge. Fail hard
    # instead of silently deploying on drifted deps.
    fail "bun install --frozen-lockfile failed — committed bun.lock does not match resolved dependencies. Regenerate locally ('bun install'), commit the refreshed bun.lock, and re-push."
fi

info "rebuilding..."
START=$(date +%s)

if ! (cd "$REPO_DIR/apps/agent" && bun run build); then
    fail "agent build failed"
fi

# nx-ev2x5.3: apps/nexus-statusline was NEVER rebuilt by this hook (only
# apps/agent was) — confirmed live 2026-07-15 that the deployed
# nexus-statusline binary had gone stale (last built 2026-07-13, several
# real source changes behind), silently shipping none of them to the
# actual `statusLine` command Claude Code invokes. This is a separate
# binary from nexus-agent (no systemd service — CC execs it directly by
# PATH on every statusline render), so it needs its own build+install
# step, not just a ride-along on the agent's.
if [[ -d "$REPO_DIR/apps/nexus-statusline" ]]; then
    if ! (cd "$REPO_DIR/apps/nexus-statusline" && bun run build); then
        fail "nexus-statusline build failed"
    fi
fi

ELAPSED=$(( $(date +%s) - START ))
info "rebuilt in ${ELAPSED}s"

# ── Stale-dist guard ──────────────────────────────────────────────
# bun build --compile produces only the binary; a dist/ directory
# indicates a leftover from `tsc` or older build tooling. Warn
# (informational only — do not fail the deploy).

if [[ -d "$REPO_DIR/apps/agent/dist" ]]; then
    warn "stale dist/ directory detected at apps/agent/dist after build — this is unexpected (bun build --compile produces only the binary). Cleanup recommended: rm -rf apps/agent/dist"
fi

# ── Install binaries ──────────────────────────────────────────────

install -m 755 "$REPO_DIR/apps/agent/nexus-agent" "$BIN_DIR/nexus-agent"
if [[ -f "$REPO_DIR/apps/nexus-statusline/nexus-statusline" ]]; then
    install -m 755 "$REPO_DIR/apps/nexus-statusline/nexus-statusline" "$BIN_DIR/nexus-statusline"
fi
info "binaries installed to $BIN_DIR/"

# ── Configure agents.toml ─────────────────────────────────────────

if [[ ! -f "$CONFIG_DIR/agents.toml" ]]; then
    LOCAL_HOST="$(hostname -s)"
    LOCAL_USER="$(whoami)"
    info "seeding default agents.toml (local agent: $LOCAL_HOST)"
    cat > "$CONFIG_DIR/agents.toml" <<EOF
[[agents]]
name = "$LOCAL_HOST"
host = "localhost"
port = 7400
user = "$LOCAL_USER"
EOF
fi

# ── Install and enable service ────────────────────────────────────

OS="$(uname -s)"
case "$OS" in
    Linux)
        SYSTEMD_DIR="$HOME/.config/systemd/user"
        mkdir -p "$SYSTEMD_DIR"
        install -m 644 "$DEPLOY_DIR/nexus-agent.service" "$SYSTEMD_DIR/nexus-agent.service"
        systemctl --user daemon-reload
        systemctl --user enable nexus-agent
        systemctl --user restart nexus-agent
        info "systemd service enabled and restarted"
        ;;
    Darwin)
        # macOS: Swift app only (env-aware-install-script owns it) — no agent daemon.
        ;;
esac

# ── Fan out to remote agents ─────────────────────────────────────
#
# Short-circuit when invoked with --force: that signal means we're a
# downstream deploy (an upstream agent SSH'd into us). Re-fanning would
# create a deploy ping-pong loop between agents. The original fanout
# already covers all peers.

if [[ "${1:-}" == "--force" ]]; then
    skip "skipping fanout (--force invocation — downstream deploy)"
    info "deploy complete"
    exit 0
fi

REMOTES=$(get_remote_agents)
if [[ -n "$REMOTES" ]]; then
    info "deploying to remote agents..."
    while IFS=$'\t' read -r target repo_dir; do
        [[ -z "$target" ]] && continue
        info "  → $target ($repo_dir, backgrounded, up to $DEPLOY_RETRY_MAX_ATTEMPTS attempts)"
        (
            sleep 2
            run_deploy_with_retry "$target" \
                "cd $repo_dir && git pull --ff-only && deploy/hooks.d/post-merge/02-deploy --force"
        ) &
    done <<< "$REMOTES"
    info "remote deploys launched in background"
fi

info "deploy complete"
