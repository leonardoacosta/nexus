#!/usr/bin/env bash
set -euo pipefail

# Nexus Agent — post-merge deploy hook
# Rebuilds and fully deploys nexus-agent when Bun source changes.
# Handles first-time setup (config, service install, enable) and updates.

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
RESET='\033[0m'

info()  { printf "${GREEN}nexus-agent: %s${RESET}\n" "$1"; }
skip()  { printf "${YELLOW}nexus-agent: %s${RESET}\n" "$1"; }
warn()  { printf "${YELLOW}nexus-agent: %s${RESET}\n" "$1" >&2; }
fail()  { printf "${RED}nexus-agent: %s${RESET}\n" "$1" >&2; exit 1; }

# Bootstrap with retry — handles macOS launchctl `Load failed: 5: I/O error`
# that recurs ~50% of the time when bootstrap immediately follows bootout
# in the same session (launchd hasn't finalized the prior bootout yet).
# Three attempts with 1s/2s/3s backoff before giving up.
#
# Without this retry, every git push has ~50% chance of leaving the agent
# unloaded — KeepAlive=true can't help because nothing got loaded at all.
# Observed today: 3 consecutive pushes, 3 silent agent-deaths in 2 hours.
bootstrap_with_retry() {
    local label="$1" plist="$2"
    local attempt pid_line pid
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    for attempt in 1 2 3; do
        sleep "$attempt"
        # Run bootstrap (ignore non-zero exit — bootstrap returns 0 even
        # after "Load failed: 5" sometimes; the real signal is whether the
        # service actually has a running pid afterwards).
        launchctl bootstrap "gui/$(id -u)" "$plist" >/dev/null 2>&1 || true
        launchctl kickstart -k "gui/$(id -u)/$label" >/dev/null 2>&1 || true
        # Verify the service has a numeric pid in launchctl list (column 1).
        # A "-" or empty column means loaded-but-not-running, which has been
        # observed today: bootstrap silently succeeds, agent never starts.
        pid_line=$(launchctl list "$label" 2>/dev/null | grep '"PID"' | head -1)
        pid=$(printf '%s' "$pid_line" | sed -nE 's/.*"PID" = ([0-9]+).*/\1/p')
        if [ -n "$pid" ] && [ "$pid" -gt 0 ] 2>/dev/null; then
            info "$label running (pid=$pid, attempt=$attempt)"
            return 0
        fi
        # Not running yet — bootout before next attempt so the next
        # bootstrap starts from a clean slate.
        launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    done
    warn "$label failed to start after 3 attempts — run: launchctl bootstrap gui/\$(id -u) $plist"
    return 1
}

# ── Check for code changes (skip with --force) ───────────────────

if [[ "${1:-}" != "--force" ]]; then
    if ! git diff-tree -r --name-only ORIG_HEAD HEAD 2>/dev/null | grep -qE '^(apps/agent/|deploy/)'; then
        skip "no code changes, skipping rebuild (use --force to override)"
        exit 0
    fi
fi

# ── Rebuild ───────────────────────────────────────────────────────

BIN_DIR="$HOME/.local/bin"
CONFIG_DIR="$HOME/.config/nexus"
REPO_DIR="$(git rev-parse --show-toplevel)"
DEPLOY_DIR="$REPO_DIR/deploy"

# Parse agents.toml for remote deploy targets.
# Returns lines of "user@host" for agents that are NOT self_name or localhost.
get_remote_agents() {
    local config="$HOME/.config/nexus/agents.toml"
    [[ ! -f "$config" ]] && return

    local self_name
    self_name=$(grep '^self_name' "$config" | sed 's/.*= *"//;s/".*//')

    # Parse [[agents]] blocks — extract name, host, user
    awk -v self="$self_name" '
        /^\[\[agents\]\]/ { name=""; host=""; user="" }
        /^name/ { gsub(/.*= *"|"/, "", $0); name=$0 }
        /^host/ { gsub(/.*= *"|"/, "", $0); host=$0 }
        /^user/ { gsub(/.*= *"|"/, "", $0); user=$0 }
        /^$/ || /^\[/ {
            if (name != "" && name != self && host != "localhost" && host != "127.0.0.1") {
                print user "@" host
            }
        }
        END {
            if (name != "" && name != self && host != "localhost" && host != "127.0.0.1") {
                print user "@" host
            }
        }
    ' "$config"
}

mkdir -p "$BIN_DIR" "$CONFIG_DIR"

info "rebuilding..."
START=$(date +%s)

if ! (cd "$REPO_DIR/apps/agent" && bun run build); then
    fail "agent build failed"
fi

ELAPSED=$(( $(date +%s) - START ))
info "rebuilt in ${ELAPSED}s"

# ── Stale-dist guard ──────────────────────────────────────────────
# bun build --compile produces only the binary; a dist/ directory
# indicates a leftover from `tsc` or older build tooling. Warn
# (informational only — do not fail the deploy).

if [[ -d "$REPO_DIR/apps/agent/dist" ]]; then
    warn "stale dist/ directory detected at apps/agent/dist after build — this is unexpected (bun build --compile produces only the binary). Cleanup recommended: rm -rf apps/agent/dist"
fi

# ── Install binaries ──────────────────────────────────────────────

install -m 755 "$REPO_DIR/apps/agent/nexus-agent" "$BIN_DIR/nexus-agent"
info "binaries installed to $BIN_DIR/"

# ── Configure agents.toml ─────────────────────────────────────────

if [[ ! -f "$CONFIG_DIR/agents.toml" ]]; then
    LOCAL_HOST="$(hostname -s)"
    LOCAL_USER="$(whoami)"
    info "seeding default agents.toml (local agent: $LOCAL_HOST)"
    cat > "$CONFIG_DIR/agents.toml" <<EOF
[[agents]]
name = "$LOCAL_HOST"
host = "localhost"
port = 7400
user = "$LOCAL_USER"
EOF
fi

# ── Install and enable service ────────────────────────────────────

OS="$(uname -s)"
case "$OS" in
    Linux)
        SYSTEMD_DIR="$HOME/.config/systemd/user"
        mkdir -p "$SYSTEMD_DIR"
        install -m 644 "$DEPLOY_DIR/nexus-agent.service" "$SYSTEMD_DIR/nexus-agent.service"
        systemctl --user daemon-reload
        systemctl --user enable nexus-agent
        systemctl --user restart nexus-agent
        info "systemd service enabled and restarted"
        ;;
    Darwin)
        LAUNCH_DIR="$HOME/Library/LaunchAgents"
        PLIST="$LAUNCH_DIR/com.nexus.agent.plist"
        mkdir -p "$LAUNCH_DIR"
        sed "s|\${USER}|$USER|g" "$DEPLOY_DIR/com.nexus.agent.plist" > "$PLIST"
        # Modern launchd: bootout (idempotent) → bootstrap → kickstart.
        # Retry-with-backoff via bootstrap_with_retry() to defeat the
        # `Load failed: 5: I/O error` race after same-session bootout.
        bootstrap_with_retry "com.nexus.agent" "$PLIST"

        # ── Notifier listener + TTS drain worker ─────────────────────────
        # Install both plists alongside the agent. The notifier script and
        # the status helper deploy to ~/bin so the plist's absolute path
        # resolves consistently across machines.
        mkdir -p "$HOME/bin"
        if [[ -f "$DEPLOY_DIR/nexus-notifier.sh" ]]; then
            install -m 755 "$DEPLOY_DIR/nexus-notifier.sh" "$HOME/bin/nexus-notifier.sh"
            info "nexus-notifier.sh installed to ~/bin"
        fi
        if [[ -f "$DEPLOY_DIR/nexus-notifier-status.sh" ]]; then
            install -m 755 "$DEPLOY_DIR/nexus-notifier-status.sh" "$HOME/bin/nexus-notifier-status.sh"
            info "nexus-notifier-status.sh installed to ~/bin"
        fi

        if [[ -f "$DEPLOY_DIR/com.nexus.notifier.plist" ]]; then
            NOTIFIER_PLIST="$LAUNCH_DIR/com.nexus.notifier.plist"
            cp "$DEPLOY_DIR/com.nexus.notifier.plist" "$NOTIFIER_PLIST"
            bootstrap_with_retry "com.nexus.notifier" "$NOTIFIER_PLIST"
        fi

        if [[ -f "$DEPLOY_DIR/com.nexus.tts-player.plist" ]]; then
            PLAYER_PLIST="$LAUNCH_DIR/com.nexus.tts-player.plist"
            cp "$DEPLOY_DIR/com.nexus.tts-player.plist" "$PLAYER_PLIST"
            bootstrap_with_retry "com.nexus.tts-player" "$PLAYER_PLIST"
        fi
        ;;
esac

# ── Fan out to remote agents ─────────────────────────────────────
#
# Short-circuit when invoked with --force: that signal means we're a
# downstream deploy (an upstream agent SSH'd into us). Re-fanning would
# create a deploy ping-pong loop between agents. The original fanout
# already covers all peers.

if [[ "${1:-}" == "--force" ]]; then
    skip "skipping fanout (--force invocation — downstream deploy)"
    info "deploy complete"
    exit 0
fi

REMOTES=$(get_remote_agents)
if [[ -n "$REMOTES" ]]; then
    info "deploying to remote agents..."
    while IFS= read -r target; do
        [[ -z "$target" ]] && continue
        info "  → $target (backgrounded)"
        (
            sleep 2
            if ssh -o ConnectTimeout=5 -o BatchMode=yes "$target" \
                "cd ~/dev/nx && git pull --ff-only && deploy/hooks.d/post-merge/02-deploy --force" \
                2>&1; then
                echo "{\"event\":\"notification\",\"message\":\"Deploy succeeded on $target\"}" \
                    | socat - UNIX-CONNECT:/tmp/nexus-agent.sock 2>/dev/null || true
            else
                echo "{\"event\":\"notification\",\"message\":\"Deploy FAILED on $target\"}" \
                    | socat - UNIX-CONNECT:/tmp/nexus-agent.sock 2>/dev/null || true
            fi
        ) &
    done <<< "$REMOTES"
    info "remote deploys launched in background"
fi

info "deploy complete"
