#!/usr/bin/env bash

# Nexus Dashboard — post-merge deploy hook
# Rebuilds the Next.js dashboard and restarts the nexus-dashboard
# systemd service when relevant source files change. Linux only.

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
RESET='\033[0m'

info() { printf "${GREEN}nexus-dashboard: %s${RESET}\n" "$1"; }
skip() { printf "${YELLOW}nexus-dashboard: %s${RESET}\n" "$1"; }
warn() { printf "${RED}nexus-dashboard: %s${RESET}\n" "$1" >&2; }

# ── Skip on macOS ────────────────────────────────────────────────

if [[ "$(uname -s)" == "Darwin" ]]; then
    skip "macOS detected, skipping (Linux only)"
    exit 0
fi

# ── Check for relevant changes ───────────────────────────────────

if ! git diff-tree -r --name-only ORIG_HEAD HEAD 2>/dev/null | grep -qE '^(apps/nextjs/|packages/db/|packages/core/)'; then
    skip "no dashboard-related changes, skipping"
    exit 0
fi

# ── Rebuild ──────────────────────────────────────────────────────

REPO_DIR="$(git rev-parse --show-toplevel)"

info "rebuilding dashboard..."
START=$(date +%s)

if ! (cd "$REPO_DIR" && pnpm --filter @nexus/nextjs build); then
    warn "dashboard build failed, skipping restart"
    exit 0
fi

ELAPSED=$(( $(date +%s) - START ))
info "rebuilt in ${ELAPSED}s"

# ── Restart service ──────────────────────────────────────────────

if ! systemctl --user restart nexus-dashboard; then
    warn "systemctl restart failed, service may need manual attention"
    exit 0
fi

info "nexus-dashboard service restarted"
