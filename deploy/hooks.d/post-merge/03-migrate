#!/usr/bin/env bash
set -uo pipefail

# Nexus DB — post-merge migration hook
# Runs db:migrate when packages/db/ changed between ORIG_HEAD and HEAD.
# Fail-soft: logs a warning on failure but never blocks subsequent hooks.

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
RESET='\033[0m'

info()  { printf "${GREEN}db-migrate: %s${RESET}\n" "$1"; }
skip()  { printf "${YELLOW}db-migrate: %s${RESET}\n" "$1"; }
warn()  { printf "${RED}db-migrate: %s${RESET}\n" "$1" >&2; }

# ── Check for schema changes ────────────────────────────────────

if ! git diff-tree -r --name-only ORIG_HEAD HEAD 2>/dev/null | grep -qE '^packages/db/'; then
    skip "no packages/db/ changes, skipping migration"
    exit 0
fi

# ── Resolve repo root ───────────────────────────────────────────

REPO_DIR="$(git rev-parse --show-toplevel)"

# ── Primary-writer gate (nx-9k141) ──────────────────────────────
#
# Only the primary DB-writing host applies the shared migration; every other
# machine (e.g. the Mac, which runs no agent daemon and has no POSTGRES_URL)
# must SKIP ENTIRELY rather than run db:migrate and fail loudly with
# "POSTGRES_URL is required" on every deploy. Two role signals, checked in
# order:
#
#   1. Explicit opt-out: NEXUS_DB_PRIMARY set to a falsey value in ~/.env or the
#      environment marks this machine as a non-primary (a read-only peer that
#      has a URL but must not migrate).
#   2. No resolvable POSTGRES_URL from the agent's canonical secrets source
#      (~/.env) or the inherited environment: a machine with nothing to write to
#      is not a DB-writing host — skip, don't fail.
#
# The primary needs zero new config: it has POSTGRES_URL and no opt-out flag, so
# it still migrates exactly as before.

AGENT_ENV="$HOME/.env"

# Read the explicit primary flag from ~/.env (falling back to the inherited env).
_db_primary_flag="${NEXUS_DB_PRIMARY:-}"
if [[ -f "$AGENT_ENV" ]]; then
    _flag_line="$(grep -E '^[[:space:]]*(export[[:space:]]+)?NEXUS_DB_PRIMARY=' "$AGENT_ENV" | tail -n1)"
    if [[ -n "$_flag_line" ]]; then
        _db_primary_flag="${_flag_line#*NEXUS_DB_PRIMARY=}"
        _db_primary_flag="${_db_primary_flag%\"}"
        _db_primary_flag="${_db_primary_flag#\"}"
    fi
fi

case "$(printf '%s' "$_db_primary_flag" | tr '[:upper:]' '[:lower:]')" in
    0|false|no|off)
        skip "NEXUS_DB_PRIMARY is falsey — non-primary machine, skipping db:migrate (primary host owns the shared migration)"
        exit 0
        ;;
esac

# ── Resolve POSTGRES_URL from the agent's canonical secrets source ──
#
# Single source of truth: the running nexus-agent reads POSTGRES_URL from
# ~/.env via its systemd `EnvironmentFile=-%h/.env` directive (see
# deploy/nexus-agent.service). The deploy hook MUST use the same source so
# the migration always targets the DB the agent actually connects to.
#
# Historical bug (nx-sbmjj): this hook sourced infra/.tf-outputs.env, which
# can hold a stale Terraform output (wrong user, stale Tailscale IP). That
# value overrode the correct URL and sent db:migrate to a dead host, hanging
# recoverTrackingIfNeeded. tf-outputs is NOT a deploy-time secrets source —
# do not source it here.

if [[ -f "$AGENT_ENV" ]]; then
    # Export only POSTGRES_URL — avoid leaking unrelated keys into the
    # migrate subprocess. Mirrors how systemd EnvironmentFile= scopes it.
    _pg_line="$(grep -E '^[[:space:]]*(export[[:space:]]+)?POSTGRES_URL=' "$AGENT_ENV" | tail -n1)"
    if [[ -n "$_pg_line" ]]; then
        POSTGRES_URL="${_pg_line#*POSTGRES_URL=}"
        POSTGRES_URL="${POSTGRES_URL%\"}"
        POSTGRES_URL="${POSTGRES_URL#\"}"
        export POSTGRES_URL
        info "resolved POSTGRES_URL from agent canonical source ($AGENT_ENV)"
    fi
fi

# Primary-writer gate (signal 2): with no POSTGRES_URL resolvable from ~/.env or
# the inherited environment, this machine has no shared DB to write to — it is
# not a DB-writing host. Skip entirely (exit 0) rather than run db:migrate and
# fail loudly with "POSTGRES_URL is required" on every deploy (nx-9k141).
if [[ -z "${POSTGRES_URL:-}" ]]; then
    skip "no POSTGRES_URL resolvable — non-primary machine, skipping db:migrate (primary host owns the shared migration)"
    exit 0
fi

# ── Run migration (fail-soft) ───────────────────────────────────

info "running db:migrate..."

if ! (cd "$REPO_DIR" && pnpm --filter @nexus/db db:migrate); then
    warn "db:migrate failed — run manually: pnpm --filter @nexus/db db:migrate"
    exit 0
fi

info "db:migrate complete"
