[Unit]
Description=Nexus Dashboard — Next.js web admin served behind Traefik
# Tailscale is NOT a dependency for the dashboard: it binds to localhost:3100
# and the reverse proxy (Traefik) handles ingress on the host network. We only
# need general network reachability so any outbound calls (e.g. database,
# upstream agent over Tailnet from inside Next.js handlers) succeed once the
# service binds. The agent unit handles its own Tailscale ordering — the
# dashboard does not need to.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dev/nx/apps/nextjs
# `pnpm --filter @nexus/nextjs start` resolves to the workspace's `next start`
# script. The PATH env below ensures /usr/bin/env can find pnpm regardless of
# whether the user installed it via corepack, npm -g, or a version manager.
ExecStart=/usr/bin/env pnpm --filter @nexus/nextjs start
# Restart always: systemd restarts the dashboard after any exit, including
# clean shutdowns (status=0). RestartSec adds a 5-second backoff.
# StartLimitBurst + StartLimitIntervalSec prevent infinite restart loops — if
# the dashboard crashes 5 times within 60 seconds, systemd marks it as failed
# rather than thrashing forever.
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

Environment=NODE_ENV=production
Environment=PORT=3100
Environment=PATH=%h/.local/bin:%h/.bun/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin

# Load machine-local secrets (DATABASE_URL, auth tokens, etc.) from ~/.env.
# Mirrors the agent unit so both services read from a single source of truth.
EnvironmentFile=-%h/.env

# Security hardening — mirrors nexus-agent.service style.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

# ReadOnlyPaths=/home enforces a read-only invariant on the user's home tree
# without using ProtectHome's mount-namespace bind (which has been observed
# to interact badly with /proc readlinks elsewhere in this repo — see
# nexus-agent.service line 61-67 for the long-form rationale).
ReadOnlyPaths=/home

# ReadWritePaths grant scoped write access for Next.js runtime artifacts:
#   .next/cache  — build/route cache, ISR snapshots, image optimisation cache
#   .next/server — server build output that next start expects on disk
#   node_modules/.cache — package-level caches (e.g. SWC, lightningcss)
# These take precedence over ReadOnlyPaths=/home for the listed subtrees.
ReadWritePaths=%h/dev/nx/apps/nextjs/.next
ReadWritePaths=%h/dev/nx/apps/nextjs/node_modules/.cache
ReadWritePaths=/tmp

# Resource limits — dashboard is heavier than the agent (V8 + Next.js runtime)
# so MemoryMax sits above the agent's 512M. Adjust if OOM kills become routine.
LimitNOFILE=65536
MemoryMax=1G
TasksMax=512

[Install]
WantedBy=default.target
