# Nexus Agent — environment variables
#
# Copy this file to .env and fill in values before starting the agent.

# ── Database ─────────────────────────────────────────────────────────

# Required: PostgreSQL connection string
POSTGRES_URL=postgresql://user:password@localhost:5432/nexus

# ── Security & Auth ──────────────────────────────────────────────────

# Required: 32-byte AES-256-GCM key for encrypting credential values at rest.
# Generate with: openssl rand -hex 32
# Accepts hex (64 chars) or base64 (44 chars).
NEXUS_ENCRYPTION_KEY=

# Required: Secret for authenticating internal service-to-service HTTP requests
# (e.g. agent push endpoints).
# Generate with: openssl rand -hex 32
NEXUS_INTERNAL_SECRET=

# Optional: Pre-rotation threshold (0.0-1.0, default 0.85).
# Credentials with 5h utilization >= this value are proactively rotated.
NEXUS_PREROTATE_THRESHOLD=0.85

# Optional: Bearer token attached to write-route relay requests to the MX
# sidecar gateway. Leave empty to forward without an Authorization header
# (fail-open forward). Read by apps/agent/src/lib/mx-gateway.ts.
MX_GATEWAY_TOKEN=

# ── Agent Configuration ──────────────────────────────────────────────

# Optional: Port the agent HTTP server listens on (default: 7400)
NEXUS_PORT=7400

# Optional: Root directory to scan for projects (default: ~/dev)
NEXUS_PROJECTS_DIR=

# Optional: Directory for nexus config files (default: ~/.config/nexus)
NEXUS_CONFIG_DIR=

# Optional: Override path to projects.toml (default:
# ~/dev/personal/installfest/home/projects.toml).
# Read by apps/agent/src/services/config-loader.ts.
NEXUS_PROJECTS_TOML=

# Optional: Allow the Kokoro TTS provider to target loopback/private hosts
# (default: disabled — set to "1" to allow). Read by
# apps/agent/src/integrations/kokoro-loopback.ts.
NEXUS_KOKORO_ALLOW_LOOPBACK=

# Optional: Path for the Unix domain socket (default: /tmp/nexus-agent.sock)
NEXUS_SOCKET=

# Optional: Interval between APNs health-push wakeups in ms (default: 1800000 = 30 min).
# Read by apps/agent/src/health-push/health-push-scheduler.ts.
HEALTH_PUSH_INTERVAL_MS=

# Optional: Tailscale presence poll interval in ms (default: 5000 = 5s).
# Read by apps/agent/src/services/tailscale-presence.ts.
NEXUS_TAILSCALE_POLL_MS=

# Optional: Credential-usage poller interval in ms (default: 300000 = 5 min).
# Read by apps/agent/src/services/credential-usage-poller.ts.
NEXUS_USAGE_POLL_INTERVAL_MS=

# Optional: MX sidecar gateway base URL (default: http://127.0.0.1:8799).
# Read by apps/agent/src/routes/{sources,triage,thread}.ts.
MX_GATEWAY_URL=

# Optional: Number of days to retain health history in the database (default: 30)
HEALTH_RETENTION_DAYS=30

# Optional: Retention windows for cron-run / bloat-radar / spec-session /
# spec-snapshot / project-status-snapshot / git-event telemetry (days).
# Read by apps/agent/src/db/retention.ts.
CRON_RUNS_RETENTION_DAYS=90
BLOAT_RADAR_RETENTION_DAYS=90
SPEC_SESSIONS_RETENTION_DAYS=365
SPEC_SNAPSHOTS_RETENTION_DAYS=90
PROJECT_STATUS_SNAPSHOTS_RETENTION_DAYS=90
GIT_EVENTS_RETENTION_DAYS=90

# Optional: Retention window (days) for stale `credentials` rows (default: 30).
# Only deletes a row that is BOTH past this window AND has no active lease
# (leased_by IS NULL), AND matches one of: status='refresh_failed', or
# is_primary=false. Never deletes an isPrimary=true row still in 'available'
# status regardless of age. Read by apps/agent/src/db/retention.ts
# (see deleteStaleCredentials()).
CREDENTIALS_RETENTION_DAYS=30

# Optional: Per-channel timeout for external notification delivery in ms (default: 10000).
# Wraps each channel handler (slack/desktop/tts) with an end-to-end budget; on timeout
# emits Sentry captureException and returns a structured failure.
NEXUS_NOTIFICATION_TIMEOUT_MS=10000

# Optional: Max concurrent subprocess spawns across the global spawn budget
# (default: 12). Read by apps/agent/src/utils/exec.ts.
GLOBAL_SPAWN_MAX_CONCURRENT=12

# Optional: Max queued callers waiting on the global spawn budget before a
# caller is rejected immediately (default: 128).
# Read by apps/agent/src/utils/exec.ts.
GLOBAL_SPAWN_QUEUE_MAX=128

# Optional: Max concurrent `bd dolt` invocations (default: 4).
# Read by apps/agent/src/utils/exec.ts.
BD_DOLT_MAX_CONCURRENT=4

# Optional: Concurrency for the project-fanout "run on all projects" helper
# (default: 8). Read by apps/agent/src/services/project-fanout.ts.
FANOUT_ALL_CONCURRENCY=8

# Optional: Tailscale peer hostname substring matched as "the phone" for
# presence detection (default: "iphone", case-insensitive).
# Read by apps/agent/src/services/tailscale-presence.ts.
NEXUS_PHONE_PEER=iphone

# Optional: Presence-context user label (default: "local").
# Read by apps/agent/src/notifications/presence-context.ts.
NEXUS_PRESENCE_USER=local

# Optional: Credential-usage poller interval in ms while a credential is
# "hot" (>= HOT_THRESHOLD_PCT utilization) (default: 60000 = 1 min).
# Read by apps/agent/src/services/credential-usage-poller.ts.
NEXUS_USAGE_POLL_HOT_INTERVAL_MS=60000

# ── Observability ────────────────────────────────────────────────────

# Optional: Log level — trace, debug, info, warn, error (default: info)
LOG_LEVEL=info

# Optional: Sentry DSN for error reporting. Leave empty to disable.
SENTRY_DSN=

# Optional: Sentry environment tag (default: production)
SENTRY_ENVIRONMENT=production

# Optional: Version tag injected into Sentry release field. Overrides the
# pnpm-injected npm_package_version; useful for Docker/CI builds that set a
# git SHA or semver. Leave empty in dev -- npm_package_version is the fallback.
NEXUS_VERSION=

# Optional: PostHog project write key. If unset, the PostHog provider no-ops
# and no analytics events are sent. Never use the admin key here.
NEXT_PUBLIC_POSTHOG_KEY=

# Optional: PostHog ingest host. Defaults to US cloud if unset.
# Options: https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: OpenTelemetry collector endpoint. Leave empty to disable.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional: OpenTelemetry service name (default: nexus)
OTEL_SERVICE_NAME=nexus

# ── Notification Channels ────────────────────────────────────────────

# Optional: ElevenLabs API key for text-to-speech notifications.
ELEVENLABS_API_KEY=

# Optional: ElevenLabs default voice ID for TTS notifications. Resolution
# order: per-project override row -> this var -> unset (signal-only; the Mac
# listener synthesizes locally). Read by apps/agent/src/notifications/router.ts.
ELEVENLABS_DEFAULT_VOICE_ID=

# DEPRECATED — legacy voice-id fallback, kept for backward compatibility only
# (openspec/specs/elevenlabs-credential/spec.md:25 mandates the env fallback
# when no elevenlabs_credentials DB row exists). Read by
# apps/agent/src/notifications/router.ts on the ELEVENLABS_API_KEY env-fallback
# path; when set there it takes precedence over ELEVENLABS_DEFAULT_VOICE_ID.
# Prefer the credential store (PATCH /elevenlabs/credentials) or
# ELEVENLABS_DEFAULT_VOICE_ID above. Do not set both voice vars.
ELEVENLABS_VOICE_ID=

# Optional: Slack incoming webhook URL for Slack notifications.
SLACK_WEBHOOK_URL=

# Optional: Telegram Bot API credentials for the `telegram` notification channel
# (general-purpose, low-priority message lane). Both must be set for delivery;
# the channel fails open (accepts the request, no-ops delivery) when either is
# unset. Bot token from @BotFather; chat id is the target chat/channel/user id.
# FALLBACK ONLY: the agent now prefers a DB-managed credential row (set via the
# dashboard's /integrations/telegram page) and only reads these env vars when
# no such row exists — see sendTelegramNotification in
# apps/agent/src/notifications/router.ts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Web Dashboard (apps/web) ─────────────────────────────────────────

# Optional: The single Nexus agent the web app attaches to, e.g.
# http://<agent-tailscale-ip>:7400. NEXT_PUBLIC_* — inlined at build time.
# Unset => the app renders a "configure agent URL" message instead of crashing.
# Read by: apps/web/src/lib/agent-config.ts.
NEXT_PUBLIC_NEXUS_AGENT_URL=

# ── Runtime ──────────────────────────────────────────────────────────

# Optional: Node runtime mode — production, development, test (default: development).
# Used by agent route handlers to gate non-production behavior (e.g. verbose error bodies).
NODE_ENV=

# ── Claude Code Integration ──────────────────────────────────────────

# Set automatically by Claude Code hooks. Identifies the current Claude session
# for session registration. Leave empty — do not set manually.
# Read by: apps/nexus-register (detect.ts).
CLAUDE_SESSION_ID=

# Set automatically by Claude Code hooks. Absolute path to the current project
# directory. Falls back to process.cwd() when unset. Leave empty — do not set manually.
# Read by: apps/nexus-status (index.ts).
CLAUDE_PROJECT_DIR=

# ── Testing ──────────────────────────────────────────────────────────

# Optional: Override path to audit-scan binary used by integration tests.
# Defaults to ~/.claude/scripts/bin/audit-scan; set only when running CI in a
# different env.
# Read by: packages/core/src/audit-suppressions.integration.test.ts.
AUDIT_SCAN_BIN=

# Optional: Test feature flag that marks "projects table is non-empty" state
# during integration tests. When truthy, tests that depend on registered
# projects will run instead of being skipped.
# Read by: apps/agent/src/routes/project-detail.test.ts (and similar).
NX_HAS_PROJECTS=

# Optional: Enables heavy/capability-gated integration tests (real servers,
# transport seams). Skipped by default so the bare per-push `turbo test`
# stays fast. Read by: apps/agent/src/testing/homelab-transport.test.ts.
NEXUS_HEAVY_TESTS=

# Optional: Enables live-Postgres integration tests. These mutate the DB, so
# set POSTGRES_URL to a throwaway TEST database when using this — never an
# unspecified/prod URL. Read by: apps/agent/src/testing/live-pg.ts.
NEXUS_PG_TESTS=

# Optional: Enables the reaper-job live-cron parser tests (skipped by
# default so CI doesn't pay the cost). Read by:
# apps/agent/src/services/reaper-job.test.ts.
NEXUS_RUN_LIVE_REAPER_TESTS=

# Optional: Override the Xcode DerivedData path used by the Swift bundle-
# integrity capture script (default: /tmp/nx-cap/itg-build).
# Read by: deploy/check-bundle-integrity.sh.
NX_BUNDLE_DERIVED_DATA=

# Optional: Bypass the on-startup DB schema-drift check (CI only — not safe
# for production). Read by: apps/agent/src/db/database.ts, index.ts.
NEXUS_SKIP_SCHEMA_CHECK=

# ── System-Provided Variables ────────────────────────────────────────
#
# The following variables are POSIX-universal and provided by the operating
# system or shell. They are documented here only to satisfy the env-var audit
# rule (H1); do NOT override them in .env — the defaults are correct.
#
# HOME — user home directory. Used by credential/config path resolution in
#        apps/agent/src/credentials/** and apps/agent/src/scripts/**.
#
# NOTIFY_SOCKET — systemd sd_notify watchdog socket path, set by systemd when
#        running as nexus-agent.service. Unset in local dev/macOS (fails
#        silently). Read by apps/agent/src/services/sd-notify.ts.
#
# USER — current OS user. Used as a git-identity fallback (after `git config
#        user.email`) when attributing spec-status actions. Read by
#        apps/agent/src/routes/specs/handlers-status.ts.

# ── Secrets-File Variables ───────────────────────────────────────────
#
# The following are read from the environment but their canonical home is
# deploy/secrets.env.example (copied to ~/.config/nexus/secrets.env per
# machine) — do NOT put them in .env. Named here so the env-var audit (H1)
# maps every source read to a documented location:
#
# NEXUS_ATTACH_SECRET, APNS_KEY_ID, APNS_TEAM_ID, APNS_KEY_PATH,
# APNS_BUNDLE_ID, APNS_HOST, HEALTH_PUSH_TOKEN_PATH, CC_CREDENTIALS_PATH,
# VM_URL, OTEL_EXPORTER_OTLP_HEADERS
