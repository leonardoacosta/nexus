{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "lint:sql-safety", "lint:audit-suppressions"]
    },
    "lint:sql-safety": {
      "cache": false
    },
    "lint:audit-suppressions": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": false,
      "env": ["POSTGRES_URL"]
    }
  }
}
